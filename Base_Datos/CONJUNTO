CREATE DATABASE CONJUNTO;
USE CONJUNTO;
#Drop database CONJUNTO;
CREATE TABLE USUARIO (
	CEDULA BIGINT UNSIGNED PRIMARY KEY,
	NOMBRE VARCHAR(25) NOT NULL,
	APELLIDO VARCHAR(25) NOT NULL,
	CLAVE VARCHAR(25) NOT NULL,
	CORREO VARCHAR(60) NOT NULL,
	TELEFONO INT UNSIGNED NOT NULL,
	GENERO ENUM('MASCULINO','FEMENINO','OTRO') NULL,
    FECHA_NACIMIENTO DATE NULL,
    TIPO_USUARIO ENUM('ADMINISTRADOR','CAJERO','CLIENTE') NOT NULL,
    ESTADO ENUM('ACTIVO','INACTIVO') DEFAULT 'ACTIVO' NOT NULL
);
CREATE TABLE PRODUCTO (
	ID_PRODUCTO TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
	NOMBRE_PRODUCTO VARCHAR(30) NOT NULL,
	DESCRIPCION_PRODUCTO VARCHAR(50) NOT NULL,
	VALOR_UNITARIO SMALLINT UNSIGNED NOT NULL,
    UNIDAD_MEDIDA VARCHAR(10) NOT NULL,
    ESTADO_PRODUCTO ENUM('ACTIVO','INACTIVO') DEFAULT('ACTIVO')
);
CREATE TABLE INVENTARIO(
	ID_ITEM TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_PRODUC TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_PRODUC) REFERENCES PRODUCTO(ID_PRODUCTO),
    UBICACION VARCHAR(40) NOT NULL,
    CANTIDAD SMALLINT UNSIGNED NOT NULL,
    ESPECIFICACIONES VARCHAR(50) NOT NULL,
    FECHA_VENCIMIENTO DATE NOT NULL,
    ESTADO ENUM('DISPONIBLE','NO DISPONIBLE') DEFAULT 'DISPONIBLE' NOT NULL
);
CREATE TABLE PROVEEDOR (
	ID_PROVEEDOR TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
	NOMBRE_PROVEEDOR VARCHAR(40) NOT NULL,
	TELEFONO BIGINT UNSIGNED NOT NULL,
	CORREO VARCHAR(40) NOT NULL,
	DIRECCION VARCHAR(50) NOT NULL,
	ESTADO ENUM('ACTIVO','INACTIVO') DEFAULT 'ACTIVO' NOT NULL
);
CREATE TABLE COMPRA (
	ID_COMPRA SMALLINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_PROVE TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_PROVE) REFERENCES PROVEEDOR(ID_PROVEEDOR),
    TOTAL_COMPRA TINYINT UNSIGNED NOT NULL,
    FECHA DATE NOT NULL,
    ESTADO ENUM("PENDIENTE","COMPLETADO","CANCELADO") DEFAULT "PENDIENTE" NOT NULL
    );
CREATE TABLE COMPRA_DETALLES(
	ID_COMPRA_DETALLES TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_COMPR SMALLINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_COMPR) REFERENCES COMPRA(ID_COMPRA),
    ID_PRODUC TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_PRODUC) REFERENCES PRODUCTO(ID_PRODUCTO),
    CANTIDAD TINYINT UNSIGNED NOT NULL,
    VALOR_UNITARIO TINYINT UNSIGNED NOT NULL,
    SUBTOTAL SMALLINT UNSIGNED NOT NULL
    );
CREATE TABLE VENTAS(
    ID_VENTA TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_CLIENTE BIGINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_CLIENTE) REFERENCES USUARIO (CEDULA),
    FECHA_VENTA DATE NOT NULL,
    ESTADO_VENTA ENUM("REALIZADA","PENDIENTE") NOT NULL,
    VALOR_TOTAL TINYINT UNSIGNED NOT NULL,
    DESCUENTO TINYINT UNSIGNED NULL
	);
CREATE TABLE DETALLE_VENTAS(
	ID_DETALLE_V TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_VENTAS TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_VENTAS) REFERENCES VENTAS(ID_VENTA),
    ID_PRODUC TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_PRODUC) REFERENCES PRODUCTO(ID_PRODUCTO),
    CANTIDAD_VENTA TINYINT UNSIGNED NOT NULL
    );
CREATE TABLE DEUDAS(
    ID_DEUDA TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_VENTA TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_VENTA) REFERENCES VENTAS (ID_VENTA),
    VALOR TINYINT UNSIGNED NOT NULL,
    PLAZO DATE NOT NULL,
    SALDO TINYINT UNSIGNED NOT NULL,
    ESTADO ENUM("PENDIENTE","SALDADA") NOT NULL
    );
CREATE TABLE PAGOS(
	ID_PAGO TINYINT UNSIGNED PRIMARY KEY AUTO_INCREMENT,
    ID_DEUDA TINYINT UNSIGNED NOT NULL,
    FOREIGN KEY (ID_DEUDA) REFERENCES DEUDAS (ID_DEUDA),
    ABONO_PAGO TINYINT UNSIGNED NOT NULL,
    FECHA DATE NOT NULL,
    ESTADO ENUM("REALIZADA","NO REALIZADA","EN PROCESO") NOT NULL
    );
